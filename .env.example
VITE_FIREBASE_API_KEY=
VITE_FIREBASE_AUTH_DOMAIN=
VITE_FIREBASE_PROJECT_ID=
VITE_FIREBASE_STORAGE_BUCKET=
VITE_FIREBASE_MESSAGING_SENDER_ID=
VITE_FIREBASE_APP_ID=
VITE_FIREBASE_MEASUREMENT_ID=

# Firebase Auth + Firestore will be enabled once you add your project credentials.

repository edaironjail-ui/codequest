@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #07111f;
  --panel: rgba(15, 23, 42, 0.84);
  --panel-alt: rgba(15, 27, 43, 0.95);
  --panel-soft: rgba(148, 163, 184, 0.08);
  --line: rgba(148, 163, 184, 0.18);
  --text: #edf6ff;
  --muted: #a5b4c5;
  --primary: #7c3aed;
  --primary-2: #2dd4bf;
  --gold: #fbbf24;
  --green: #34d399;
  --shadow: rgba(7, 17, 31, 0.5);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(124, 58, 237, 0.25), transparent 35%),
    linear-gradient(135deg, #020817 0%, #091427 40%, #0b172a 100%);
  color: var(--text);
  font-family: 'Inter', sans-serif;
}

button {
  font: inherit;
  cursor: pointer;
  border: none;
}

.app-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
  padding: 32px;
  gap: 24px;
}

.sidebar,
.panel,
.hero,
.stat-card,
.mini-card {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 20px 45px var(--shadow);
  backdrop-filter: blur(14px);
}

.sidebar {
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px 8px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 900;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  box-shadow: 0 12px 28px rgba(124, 58, 237, 0.5);
}

.brand-block h1,
.topbar h2,
.hero h3,
.panel-header h3,
.quest-card h4,
.stat-card h3 {
  margin: 0;
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--primary-2);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 11px;
  font-weight: 700;
}

.eyebrow.muted {
  color: var(--muted);
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  background: transparent;
  color: var(--text);
  border: 1px solid transparent;
  text-align: left;
  border-radius: 12px;
  padding: 12px 14px;
  transition: 0.2s ease;
}

.nav-item.active,
.nav-item:hover {
  background: rgba(124, 58, 237, 0.12);
  border-color: rgba(124, 58, 237, 0.3);
}

.mini-card {
  padding: 18px;
  background: linear-gradient(160deg, rgba(45, 212, 191, 0.12), rgba(124, 58, 237, 0.08));
}

.mini-card h3 {
  margin: 8px 0;
  font-size: 1.6rem;
}

.mini-card span,
.mission-item p,
.hero-copy p,
.challenge-list,
.quest-card p,
.sync-box p,
.stat-card small,
.device-list span,
.mission-footer,
.panel-header span,
.daily-quest p {
  color: var(--muted);
}

.main-panel {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.topbar,
.panel-header,
.cta-row,
.mission-footer,
.device-list,
.top-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.topbar {
  padding: 8px 4px 0;
}

.primary-btn,
.ghost-btn {
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), #8b5cf6);
  color: white;
  box-shadow: 0 14px 24px rgba(124, 58, 237, 0.3);
}

.ghost-btn {
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid var(--line);
  color: var(--text);
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  padding: 28px;
  overflow: hidden;
}

.pill {
  display: inline-block;
  background: rgba(45, 212, 191, 0.11);
  color: var(--primary-2);
  border: 1px solid rgba(45, 212, 191, 0.25);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero-copy h3 {
  margin-top: 16px;
  font-size: clamp(2rem, 3vw, 3rem);
}

.hero-copy p {
  margin-top: 14px;
  line-height: 1.7;
  max-width: 620px;
}

.cta-row {
  justify-content: flex-start;
  margin-top: 22px;
}

.hero-visual {
  position: relative;
  min-height: 260px;
  display: grid;
  place-items: center;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(8px);
}

.orb-one {
  width: 180px;
  height: 180px;
  background: rgba(124, 58, 237, 0.45);
  transform: translate(-60px, -10px);
}

.orb-two {
  width: 150px;
  height: 150px;
  background: rgba(45, 212, 191, 0.35);
  transform: translate(80px, 40px);
}

.code-card {
  position: relative;
  z-index: 2;
  width: min(100%, 370px);
  padding: 18px 18px 12px;
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 22px;
  box-shadow: 0 24px 50px rgba(7, 17, 31, 0.52);
}

.code-topbar {
  display: flex;
  gap: 7px;
  margin-bottom: 12px;
}

.code-topbar span {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.code-topbar span:nth-child(1) { background: #f87171; }
.code-topbar span:nth-child(2) { background: #fbbf24; }
.code-topbar span:nth-child(3) { background: #4ade80; }

.code-snippet {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-family: 'SFMono-Regular', Consolas, monospace;
  color: #dbeafe;
  line-height: 1.5;
  font-size: 0.9rem;
}

.stats-grid,
.content-grid,
.bottom-grid {
  display: grid;
  gap: 18px;
}

.stats-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.stat-card {
  padding: 20px 18px;
}

.stat-card p {
  margin: 0 0 10px;
  color: var(--muted);
}

.meter {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.12);
  overflow: hidden;
  margin-top: 12px;
}

.meter span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--primary-2), var(--primary));
}

.content-grid {
  grid-template-columns: 1.5fr 0.9fr;
}

.bottom-grid {
  grid-template-columns: 1.2fr 0.8fr;
}

.panel {
  padding: 20px 18px;
}

.panel-header {
  margin-bottom: 18px;
}

.mission-list,
.challenge-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mission-item {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 14px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px 14px;
  background: rgba(148, 163, 184, 0.03);
}

.active-module {
  border-color: rgba(124, 58, 237, 0.4);
  background: rgba(124, 58, 237, 0.08);
}

.mission-icon {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: rgba(124, 58, 237, 0.1);
  font-size: 1.1rem;
}

.mission-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 8px;
}

.mission-meta strong {
  font-size: 1rem;
}

.mission-meta span {
  color: var(--primary-2);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
}

.mission-item p {
  margin: 0;
  line-height: 1.6;
}

.mission-footer {
  margin-top: 10px;
  font-size: 0.8rem;
}

.quest-card {
  padding: 18px;
  border-radius: 18px;
  border: 1px solid rgba(45, 212, 191, 0.18);
  background: linear-gradient(160deg, rgba(45, 212, 191, 0.08), rgba(124, 58, 237, 0.05));
}

.challenge-list {
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
}

.challenge-list li {
  position: relative;
  padding-left: 22px;
  line-height: 1.8;
}

.challenge-list li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-size: 1.5rem;
  line-height: 1.2;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 120px;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: rgba(15, 23, 42, 0.6);
  text-align: center;
  padding: 12px;
}

.badge.unlocked {
  border-color: rgba(251, 191, 36, 0.35);
  background: rgba(251, 191, 36, 0.08);
}

.badge.locked {
  opacity: 0.6;
  filter: grayscale(0.18);
}

.badge span {
  font-size: 2rem;
}

.sync-box {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 14px 12px;
  border-radius: 16px;
  background: rgba(52, 211, 153, 0.08);
  border: 1px solid rgba(52, 211, 153, 0.25);
}

.status-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 16px rgba(52, 211, 153, 0.8);
}

.device-list {
  margin-top: 18px;
  justify-content: flex-start;
  flex-wrap: wrap;
}

.device-list span {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.06);
  border: 1px solid var(--line);
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    padding: 16px;
  }
}

@media (max-width: 760px) {
  .app-shell {
    padding: 18px;
  }

  .hero,
  .content-grid,
  .bottom-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .topbar,
  .panel-header,
  .cta-row,
  .mission-footer,
  .top-actions {
    flex-wrap: wrap;
    align-items: flex-start;
  }
}
